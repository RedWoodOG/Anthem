# Anthem Platform — Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env to git.

# ── Required ────────────────────────────────────
POSTGRES_PASSWORD=         # Generate: openssl rand -base64 32
GRAFANA_PASSWORD=          # Generate: openssl rand -base64 16

# ── LLM API Keys (at least one required for UIE) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Optional ────────────────────────────────────
ENVIRONMENT=development    # development | production
REQUIRE_API_KEYS=false     # Set true in production
POSTGRES_USER=anthem
